        }
      ]
    },
    {
      "name": "Actualizar canción",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/canciones/{{cancionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "canciones",
            "{{cancionId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Yesterday (Remastered)\",\n  \"ritmo\": \"Balada\",\n  \"duracionSegundos\": 126,\n  \"album\": \"Help!\",\n  \"posicionEnAlbum\": 13,\n  \"banda\": \"The Beatles\",\n  \"interprete\": \"Paul McCartney\",\n  \"autor\": \"Lennon-McCartney\",\n  \"fechaLanzamiento\": \"1965-08-06\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Eliminar canción",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/canciones/{{cancionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "canciones",
            "{{cancionId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar sin token (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/canciones",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "canciones"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
